generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["typedSql", "partialIndexes", "postgresqlExtensions", "relationJoins", "views"]
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../docs/er-diagram.svg"
  theme    = "neutral"
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// ───────────────────────────── enums (internal state machines) ─────────────────────────────

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

enum StaffUserStatus {
  ACTIVE
  DEACTIVATED
}

enum SessionSubjectType {
  CUSTOMER
  STAFF
}

enum ActorType {
  CUSTOMER
  STAFF
  COURIER
  SYSTEM
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
  MULTI_ENUM
}

enum AttributeScope {
  PRODUCT
  VARIANT_OPTION
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TaggingStatus {
  UNTAGGED
  TAGGED
}

enum InventoryMovementType {
  RESERVE
  RELEASE
  DISPATCH
  RETURN_RESTOCK
  RTO_RESTOCK
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

enum DiscountType {
  FLAT
  PERCENT
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
  RTO
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  PENDING
  COLLECTED
  FAILED
  VOIDED
}

enum ShipmentStatus {
  PENDING
  PACKED
  AWB_PENDING
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RTO_INITIATED
  RTO_RECEIVED
  CANCELLED
}

enum CourierWebhookProcessingResult {
  RECEIVED
  PROCESSED
  DUPLICATE
  FAILED
}

enum ReturnRequestType {
  RETURN
  EXCHANGE
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  RECEIVED
  RESTOCKED
  REFUNDED
  EXCHANGED
}

enum RefundMethod {
  BANK_TRANSFER
  UPI
}

// ───────────────────────────── identity ─────────────────────────────

model Customer {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fullName     String         @map("full_name")
  email        String         @unique
  phone        String         @unique
  passwordHash String         @map("password_hash")
  status       CustomerStatus @default(ACTIVE)
  blockedAt    DateTime?      @map("blocked_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  addresses         CustomerAddress[]
  cart              Cart?
  orders            Order[]
  couponRedemptions CouponRedemption[]
  reviews           Review[]
  returnRequests    ReturnRequest[]

  @@map("customers")
}

model CustomerAddress {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  recipientName String    @map("recipient_name")
  phone         String
  addressLine1  String    @map("address_line1")
  addressLine2  String?   @map("address_line2")
  landmark      String?
  city          String
  state         String
  pincode       String    @db.VarChar(6)
  isDefault     Boolean   @default(false) @map("is_default")
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([customerId], map: "customer_addresses_one_default_per_customer", where: raw("is_default"))
  @@index([customerId])
  @@map("customer_addresses")
}

model StaffUser {
  id           String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fullName     String          @map("full_name")
  email        String          @unique
  passwordHash String          @map("password_hash")
  status       StaffUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?       @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles                 StaffUserRole[]
  decidedReturnRequests ReturnRequest[]
  recordedRefunds       Refund[]

  @@map("staff_users")
}

model Role {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  staffUsers  StaffUserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model StaffUserRole {
  staffUserId String   @map("staff_user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([staffUserId, roleId])
  @@index([roleId])
  @@map("staff_user_roles")
}

model Session {
  id          String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash   String             @unique @map("token_hash") @db.Char(64)
  subjectType SessionSubjectType @map("subject_type")
  subjectId   String             @map("subject_id") @db.Uuid
  expiresAt   DateTime           @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?          @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([subjectType, subjectId])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpChallenge {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phone        String
  codeHash     String    @map("code_hash") @db.Char(64)
  attemptCount Int       @default(0) @map("attempt_count")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSentAt   DateTime  @map("last_sent_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phone, createdAt(sort: Desc)])
  @@map("otp_challenges")
}

model RateLimitCounter {
  bucketKey       String   @map("bucket_key")
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  requestCount    Int      @default(0) @map("request_count")

  @@id([bucketKey, windowStartedAt])
  @@index([windowStartedAt])
  @@map("rate_limit_counters")
}

// ───────────────────────────── catalogue ─────────────────────────────

model ProductType {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String    @unique
  name        String
  description String?
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  attributeDefinitions AttributeDefinition[]
  products             Product[]

  @@map("product_types")
}

model AttributeDefinition {
  id            String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productTypeId String            @map("product_type_id") @db.Uuid
  code          String
  label         String
  dataType      AttributeDataType @map("data_type")
  scope         AttributeScope
  isRequired    Boolean           @default(false) @map("is_required")
  isFilterable  Boolean           @default(false) @map("is_filterable")
  isSearchable  Boolean           @default(false) @map("is_searchable")
  allowedValues Json?             @map("allowed_values")
  displayOrder  Int               @default(0) @map("display_order")
  archivedAt    DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  productType ProductType @relation(fields: [productTypeId], references: [id], onDelete: Restrict)

  @@unique([productTypeId, code])
  @@map("attribute_definitions")
}

model Brand {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("brands")
}

model Product {
  id                 String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productTypeId      String        @map("product_type_id") @db.Uuid
  brandId            String        @map("brand_id") @db.Uuid
  categoryId         String?       @map("category_id") @db.Uuid
  taggingStatus      TaggingStatus @default(UNTAGGED) @map("tagging_status")
  productGroupId     String?       @map("product_group_id") @db.Uuid
  groupDisplayOrder  Int?          @map("group_display_order")
  groupSwatchLabel   String?       @map("group_swatch_label")
  name               String
  slug               String        @unique
  description        String        @default("")
  status             ProductStatus @default(DRAFT)
  attributes         Json          @default("{}")
  taxRateBasisPoints Int           @map("tax_rate_basis_points")
  metadata           Json          @default("{}")
  archivedAt         DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  productType        ProductType         @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  productGroup       ProductGroup?       @relation(fields: [productGroupId], references: [id], onDelete: Restrict)
  variants           ProductVariant[]
  media              ProductMedia[]
  collectionProducts CollectionProduct[]
  reviews            Review[]
  orderItems         OrderItem[]

  @@index([status, createdAt(sort: Desc)])
  @@index([categoryId])
  @@index([brandId])
  @@index([productTypeId])
  @@index([productGroupId])
  @@index([taggingStatus, createdAt(sort: Desc)])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "products_name_trigram_idx", type: Gin)
  @@index([attributes(ops: JsonbPathOps)], map: "products_attributes_path_idx", type: Gin)
  @@map("products")
}

model ProductVariant {
  id              String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId       String               @map("product_id") @db.Uuid
  sku             String               @unique
  optionValues    Json                 @default("{}") @map("option_values")
  optionSignature String               @map("option_signature")
  mrpPaise        Int                  @map("mrp_paise")
  pricePaise      Int                  @map("price_paise")
  weightGrams     Int                  @map("weight_grams")
  lengthMm        Int                  @map("length_mm")
  breadthMm       Int                  @map("breadth_mm")
  heightMm        Int                  @map("height_mm")
  status          ProductVariantStatus @default(ACTIVE)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product             Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  media               ProductMedia[]
  inventoryLevels     InventoryLevel[]
  inventoryMovements  InventoryMovement[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  exchangeReturnItems ReturnRequestItem[]

  @@unique([productId, optionSignature])
  @@map("product_variants")
}

model ProductMedia {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  url       String
  altText   String   @default("") @map("alt_text")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([productId, position])
  @@index([variantId])
  @@map("product_media")
}

// ───────────────────────────── taxonomy ─────────────────────────────

model Category {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  level     Int      @db.SmallInt
  name      String
  slug      String   @unique
  path      String
  isActive  Boolean  @default(true) @map("is_active")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([path(ops: raw("gin_trgm_ops"))], map: "categories_path_trigram_idx", type: Gin)
  @@index([parentId, position])
  @@map("categories")
}

// ───────────────────────────── grouping ─────────────────────────────

model ProductGroup {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  memberCount Int      @default(0) @map("member_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("product_groups")
}

// ───────────────────────────── merchandising ─────────────────────────────

model Collection {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  slug        String    @unique
  description String    @default("")
  isActive    Boolean   @default(true) @map("is_active")
  startsAt    DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  collectionId String   @map("collection_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
}

model Banner {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title     String
  imageUrl  String    @map("image_url")
  linkUrl   String    @map("link_url")
  position  Int       @default(0)
  isActive  Boolean   @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("banners")
}

model Review {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  orderItemId String   @unique @map("order_item_id") @db.Uuid
  rating      Int      @db.SmallInt
  title       String   @default("")
  body        String   @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt(sort: Desc)])
  @@index([customerId])
  @@map("reviews")
}

// ───────────────────────────── inventory ─────────────────────────────

model Warehouse {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code         String   @unique
  name         String
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String
  state        String
  pincode      String   @db.VarChar(6)
  contactName  String   @map("contact_name")
  contactPhone String   @map("contact_phone")
  priority     Int
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventoryLevels    InventoryLevel[]
  inventoryMovements InventoryMovement[]
  shipments          Shipment[]
  returnRequests     ReturnRequest[]

  @@index([isActive, priority])
  @@map("warehouses")
}

model InventoryLevel {
  variantId         String   @map("variant_id") @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  onHandQuantity    Int      @default(0) @map("on_hand_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  // generated column in SQL; never written by the client
  availableQuantity Int      @default(dbgenerated("(on_hand_quantity - reserved_quantity)")) @map("available_quantity")
  lowStockThreshold Int      @default(0) @map("low_stock_threshold")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([variantId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_levels")
}

model InventoryMovement {
  id            String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  variantId     String                @map("variant_id") @db.Uuid
  warehouseId   String                @map("warehouse_id") @db.Uuid
  movementType  InventoryMovementType @map("movement_type")
  quantityDelta Int                   @map("quantity_delta")
  onHandAfter   Int                   @map("on_hand_after")
  reservedAfter Int                   @map("reserved_after")
  referenceType String?               @map("reference_type")
  referenceId   String?               @map("reference_id") @db.Uuid
  actorType     ActorType             @map("actor_type")
  actorId       String?               @map("actor_id") @db.Uuid
  reason        String?
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt(sort: Desc)])
  @@index([warehouseId, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

// ───────────────────────────── cart ─────────────────────────────

model Cart {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerId      String   @unique @map("customer_id") @db.Uuid
  appliedCouponId String?  @map("applied_coupon_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appliedCoupon Coupon?    @relation(fields: [appliedCouponId], references: [id], onDelete: Restrict)
  items         CartItem[]

  @@index([appliedCouponId])
  @@map("carts")
}

model CartItem {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cartId              String   @map("cart_id") @db.Uuid
  variantId           String   @map("variant_id") @db.Uuid
  quantity            Int
  addedUnitPricePaise Int      @map("added_unit_price_paise")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// ───────────────────────────── pricing ─────────────────────────────

model Coupon {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code             String       @unique
  description      String       @default("")
  discountType     DiscountType @map("discount_type")
  // paise for FLAT, whole percent for PERCENT
  discountValue    Int          @map("discount_value")
  maxDiscountPaise Int?         @map("max_discount_paise")
  minCartPaise     Int          @default(0) @map("min_cart_paise")
  validFrom        DateTime     @map("valid_from") @db.Timestamptz(6)
  validUntil       DateTime     @map("valid_until") @db.Timestamptz(6)
  totalUsageLimit  Int?         @map("total_usage_limit")
  perCustomerLimit Int?         @map("per_customer_limit")
  firstOrderOnly   Boolean      @default(false) @map("first_order_only")
  usedCount        Int          @default(0) @map("used_count")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  redemptions CouponRedemption[]
  carts       Cart[]

  @@map("coupons")
}

model CouponRedemption {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  couponId      String   @map("coupon_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  orderId       String   @unique @map("order_id") @db.Uuid
  discountPaise Int      @map("discount_paise")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId, customerId])
  @@index([customerId])
  @@map("coupon_redemptions")
}

model StoreSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("store_settings")
}

// ───────────────────────────── ordering ─────────────────────────────

model Order {
  id                 String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderNumber        String        @unique @map("order_number")
  customerId         String        @map("customer_id") @db.Uuid
  idempotencyKey     String        @map("idempotency_key")
  requestFingerprint String        @map("request_fingerprint")
  status             OrderStatus   @default(PLACED)
  paymentMethod      PaymentMethod @default(COD) @map("payment_method")
  subtotalPaise      Int           @map("subtotal_paise")
  discountPaise      Int           @default(0) @map("discount_paise")
  taxPaise           Int           @map("tax_paise")
  shippingFeePaise   Int           @default(0) @map("shipping_fee_paise")
  codFeePaise        Int           @default(0) @map("cod_fee_paise")
  totalPaise         Int           @map("total_paise")
  currencyCode       String        @default("INR") @map("currency_code") @db.Char(3)
  shippingAddress    Json          @map("shipping_address")
  couponCode         String?       @map("coupon_code")
  placedAt           DateTime      @default(now()) @map("placed_at") @db.Timestamptz(6)
  metadata           Json          @default("{}")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer         Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  payment          Payment?
  shipments        Shipment[]
  couponRedemption CouponRedemption?
  returnRequests   ReturnRequest[]      @relation("ReturnRequestOrder")
  exchangeFor      ReturnRequest[]      @relation("ReturnRequestExchangeOrder")
  refunds          Refund[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, placedAt(sort: Desc)])
  @@index([status, placedAt(sort: Desc)])
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId            String   @map("order_id") @db.Uuid
  variantId          String   @map("variant_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  productName        String   @map("product_name")
  brandName          String   @map("brand_name")
  sku                String
  optionValues       Json     @default("{}") @map("option_values")
  imageUrl           String?  @map("image_url")
  quantity           Int
  mrpPaise           Int      @map("mrp_paise")
  unitPricePaise     Int      @map("unit_price_paise")
  taxRateBasisPoints Int      @map("tax_rate_basis_points")
  taxPaise           Int      @map("tax_paise")
  lineTotalPaise     Int      @map("line_total_paise")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant            ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  shipmentItems      ShipmentItem[]
  review             Review?
  returnRequestItems ReturnRequestItem[]

  @@index([orderId])
  @@index([variantId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  ActorType    @map("actor_type")
  actorId    String?      @map("actor_id") @db.Uuid
  reason     String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ───────────────────────────── payment ─────────────────────────────

model Payment {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId       String        @unique @map("order_id") @db.Uuid
  paymentMethod PaymentMethod @map("payment_method")
  status        PaymentStatus @default(PENDING)
  amountPaise   Int           @map("amount_paise")
  collectedAt   DateTime?     @map("collected_at") @db.Timestamptz(6)
  failedAt      DateTime?     @map("failed_at") @db.Timestamptz(6)
  voidedAt      DateTime?     @map("voided_at") @db.Timestamptz(6)
  reference     String?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("payments")
}

// ───────────────────────────── fulfilment ─────────────────────────────

model CourierPartner {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        String   @unique
  name        String
  adapterKey  String   @map("adapter_key")
  supportsCod Boolean  @default(true) @map("supports_cod")
  priority    Int
  isActive    Boolean  @default(true) @map("is_active")
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  serviceablePincodes CourierServiceablePincode[]
  shipments           Shipment[]
  webhookReceipts     CourierWebhookReceipt[]

  @@map("courier_partners")
}

model CourierServiceablePincode {
  courierPartnerId String   @map("courier_partner_id") @db.Uuid
  pincode          String   @db.VarChar(6)
  codAvailable     Boolean  @default(true) @map("cod_available")
  maxCodValuePaise Int?     @map("max_cod_value_paise")
  etaDays          Int      @map("eta_days")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  courierPartner CourierPartner @relation(fields: [courierPartnerId], references: [id], onDelete: Restrict)

  @@id([courierPartnerId, pincode])
  @@index([pincode])
  @@map("courier_serviceable_pincodes")
}

model Shipment {
  id                   String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId              String         @map("order_id") @db.Uuid
  warehouseId          String         @map("warehouse_id") @db.Uuid
  courierPartnerId     String?        @map("courier_partner_id") @db.Uuid
  status               ShipmentStatus @default(PENDING)
  awbNumber            String?        @unique @map("awb_number")
  providerShipmentId   String?        @map("provider_shipment_id")
  labelUrl             String?        @map("label_url")
  deliveryAttemptCount Int            @default(0) @map("delivery_attempt_count")
  packedAt             DateTime?      @map("packed_at") @db.Timestamptz(6)
  shippedAt            DateTime?      @map("shipped_at") @db.Timestamptz(6)
  deliveredAt          DateTime?      @map("delivered_at") @db.Timestamptz(6)
  cancelledAt          DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  rtoReceivedAt        DateTime?      @map("rto_received_at") @db.Timestamptz(6)
  metadata             Json           @default("{}")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order          Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  warehouse      Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  courierPartner CourierPartner?         @relation(fields: [courierPartnerId], references: [id], onDelete: Restrict)
  items          ShipmentItem[]
  trackingEvents ShipmentTrackingEvent[]

  @@index([orderId])
  @@index([warehouseId, status])
  @@index([courierPartnerId, status])
  @@map("shipments")
}

model ShipmentItem {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId  String   @map("shipment_id") @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  quantity    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
  @@map("shipment_items")
}

model ShipmentTrackingEvent {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId      String         @map("shipment_id") @db.Uuid
  providerEventId String         @map("provider_event_id")
  status          ShipmentStatus
  description     String         @default("")
  location        String?
  occurredAt      DateTime       @map("occurred_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, providerEventId])
  @@map("shipment_tracking_events")
}

model CourierWebhookReceipt {
  id               String                         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courierPartnerId String                         @map("courier_partner_id") @db.Uuid
  providerEventId  String                         @map("provider_event_id")
  awbNumber        String?                        @map("awb_number")
  payload          Json
  processingResult CourierWebhookProcessingResult @default(RECEIVED) @map("processing_result")
  errorMessage     String?                        @map("error_message")
  receivedAt       DateTime                       @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime?                      @map("processed_at") @db.Timestamptz(6)

  courierPartner CourierPartner @relation(fields: [courierPartnerId], references: [id], onDelete: Restrict)

  @@unique([courierPartnerId, providerEventId])
  @@map("courier_webhook_receipts")
}

// ───────────────────────────── returns ─────────────────────────────

model ReturnRequest {
  id                   String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  returnNumber         String              @unique @map("return_number")
  orderId              String              @map("order_id") @db.Uuid
  customerId           String              @map("customer_id") @db.Uuid
  requestType          ReturnRequestType   @map("request_type")
  status               ReturnRequestStatus @default(REQUESTED)
  reason               String
  resolutionNote       String?             @map("resolution_note")
  receivingWarehouseId String?             @map("receiving_warehouse_id") @db.Uuid
  exchangeOrderId      String?             @map("exchange_order_id") @db.Uuid
  decidedByStaffId     String?             @map("decided_by_staff_id") @db.Uuid
  decidedAt            DateTime?           @map("decided_at") @db.Timestamptz(6)
  requestedAt          DateTime            @default(now()) @map("requested_at") @db.Timestamptz(6)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order              Order               @relation("ReturnRequestOrder", fields: [orderId], references: [id], onDelete: Restrict)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  receivingWarehouse Warehouse?          @relation(fields: [receivingWarehouseId], references: [id], onDelete: Restrict)
  exchangeOrder      Order?              @relation("ReturnRequestExchangeOrder", fields: [exchangeOrderId], references: [id], onDelete: Restrict)
  decidedByStaff     StaffUser?          @relation(fields: [decidedByStaffId], references: [id], onDelete: Restrict)
  items              ReturnRequestItem[]
  refund             Refund?

  @@index([orderId])
  @@index([customerId, requestedAt(sort: Desc)])
  @@index([status, requestedAt(sort: Desc)])
  @@index([receivingWarehouseId])
  @@index([exchangeOrderId])
  @@index([decidedByStaffId])
  @@map("return_requests")
}

model ReturnRequestItem {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  returnRequestId   String   @map("return_request_id") @db.Uuid
  orderItemId       String   @map("order_item_id") @db.Uuid
  quantity          Int
  exchangeVariantId String?  @map("exchange_variant_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  returnRequest   ReturnRequest   @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  orderItem       OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  exchangeVariant ProductVariant? @relation(fields: [exchangeVariantId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
  @@index([exchangeVariantId])
  @@map("return_request_items")
}

model Refund {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  returnRequestId   String       @unique @map("return_request_id") @db.Uuid
  orderId           String       @map("order_id") @db.Uuid
  amountPaise       Int          @map("amount_paise")
  refundMethod      RefundMethod @map("refund_method")
  reference         String
  refundedAt        DateTime     @map("refunded_at") @db.Timestamptz(6)
  recordedByStaffId String       @map("recorded_by_staff_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recordedByStaff StaffUser     @relation(fields: [recordedByStaffId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([recordedByStaffId])
  @@map("refunds")
}

// ───────────────────────────── platform ─────────────────────────────

model AuditLog {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?   @map("ip_address") @db.Inet
  requestId  String?   @map("request_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt], map: "audit_logs_created_at_brin_idx", type: Brin)
  @@map("audit_logs")
}

model SearchOutbox {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([createdAt], map: "search_outbox_unprocessed_idx", where: raw("processed_at IS NULL"))
  @@map("search_outbox")
}
