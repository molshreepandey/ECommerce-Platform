{
  "surfaces": {
    "store": {
      "hosts": ["store.staging.example.com"],
      "publicOrigin": "https://store.staging.example.com"
    },
    "admin": {
      "hosts": ["admin.staging.example.com"],
      "publicOrigin": "https://admin.staging.example.com"
    }
  },
  "logging": {
    "level": "info"
  },
  "database": {
    "poolMaxConnections": 10,
    "connectionTimeoutMilliseconds": 5000,
    "idleTimeoutMilliseconds": 30000
  },
  "elasticsearch": {
    "indexPrefix": "staging",
    "requestTimeoutMilliseconds": 2000,
    "maxRetries": 0
  },
  "redis": {
    "keyPrefix": "ecom:staging:",
    "connectTimeoutMilliseconds": 1000,
    "replyTimeoutMilliseconds": 500,
    "maxReconnectDelayMilliseconds": 2000,
    "failureCooldownMilliseconds": 5000
  },
  "health": {
    "probeTimeoutMilliseconds": 2000
  },
  "rateLimits": {
    "customer-login": {
      "maxRequests": 5,
      "windowSeconds": 60
    },
    "customer-register": {
      "maxRequests": 10,
      "windowSeconds": 3600
    },
    "staff-login": {
      "maxRequests": 5,
      "windowSeconds": 60
    }
  },
  "security": {
    "strictTransportSecurityMaxAgeSeconds": 86400,
    "contentSecurityPolicy": {
      "imageSources": ["https://picsum.photos", "https://fastly.picsum.photos", "data:", "blob:"],
      "connectSources": [],
      "scriptSources": [],
      "frameSources": []
    }
  },
  "authentication": {
    "customerSessionTtlDays": 30,
    "staffSessionTtlHours": 12,
    "secureCookies": true,
    "trustedProxyHopCount": 0,
    "demoAccountsAllowed": false,
    "passwordHashing": {
      "memoryCostKib": 19456,
      "timeCost": 2,
      "parallelism": 1
    }
  }
}
