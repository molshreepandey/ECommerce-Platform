# Which config/config.<APP_ENV>.json to load at server start: development | test | staging | production
APP_ENV=development
# Optional: load configuration from another file instead (runtime override, no rebuild needed)
# APP_CONFIG_PATH=/etc/ecommerce/config.json

# Connection strings (local development placeholders only; real credentials never go in this file)
DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5433/ecommerce
# Integration tests only. The name must end with _test; the harness refuses anything else.
TEST_DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5433/ecommerce_test
ELASTICSEARCH_URL=http://localhost:9200
REDIS_URL=redis://localhost:6379

# HMAC secret for demo courier webhooks (at least 32 characters). Optional in development and test;
# required in staging and production. Placeholder only:
# COURIER_WEBHOOK_SECRET=replace-with-a-random-secret-of-32-characters-or-more
# Login OTP popup (plan C3): unset = shown everywhere except production. Must be false in production.
# OTP_DISPLAY_IN_UI=true
