{
  "name": "ecommerce-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --generator client",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "docs:erd": "prisma generate --generator erd",
    "test:http": "vitest run --config vitest.http.config.ts",
    "test:http:dev": "TEST_SERVER_MODE=development vitest run --config vitest.http.config.ts",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate --generator client",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start:test": "tsx scripts/start-test-server.ts",
    "start:test:dev": "tsx scripts/start-test-server.ts --dev",
    "db:seed:demo-passwords": "tsx prisma/seed/demo-passwords.ts",
    "db:seed:catalogue": "tsx scripts/seed-demo-catalogue.ts",
    "search:sync": "tsx scripts/search-sync.ts",
    "search:reindex": "tsx scripts/search-reindex.ts",
    "orders:expire-unpaid": "tsx scripts/expire-unpaid-orders.ts",
    "admin:create-first": "tsx scripts/create-first-admin.ts",
    "docs:openapi": "tsx scripts/generate-openapi.ts && prettier --write docs/openapi.json"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "chart.js": "^4.6.1",
    "class-variance-authority": "^0.7.1",
    "geist": "^1.9.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.3.0",
    "redis": "6.3.1",
    "swagger-ui-dist": "5.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.17.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "prisma-erd-generator": "^3.2.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "puppeteer@25.16.0": true,
    "fsevents": false
  },
  "scarfSettings": {
    "enabled": false
  }
}
